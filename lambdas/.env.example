# CloudFront Configuration
CLOUDFRONT_URL=https://d2zhlpwgezwmiu.cloudfront.net
VIDEO_BASE_URL=https://d2zhlpwgezwmiu.cloudfront.net

# CORS Configuration
CORS_ORIGIN=*

# Supported Lessons Configuration
GRADE_LEVELS=4
TOPICS=multiplication

# AWS Resources (created by serverless)
ANALYTICS_TABLE=brunnr-analytics
ENGAGEMENT_TABLE=brunnr-engagement
PERFORMANCE_TABLE=brunnr-performance

# API Keys (if needed)
API_KEY=your-api-key-here

# Environment
STAGE=dev

# RDS Configuration (optional - functions work without it)
# RDS_HOST=your-rds-endpoint.amazonaws.com
# RDS_PORT=3306
# RDS_USER=lambda_user
# RDS_PASSWORD=secure_password
# RDS_DATABASE=brunnr_analytics

# VPC Configuration (needed for RDS access)
# LAMBDA_SECURITY_GROUP=sg-xxxxxxxxx
# LAMBDA_SUBNET_1=subnet-xxxxxxxxx
# LAMBDA_SUBNET_2=subnet-yyyyyyyyy
